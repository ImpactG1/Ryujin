# Ryujin Discord Bot & API Configuration

# Discord Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_PUBLIC_KEY=your_discord_public_key

# Owner Configuration (Discord User ID only for persona verification)
OWNER_DISCORD_ID=123456789012345678
OWNER_HANDLE=mayankbereal1

# Database Configuration (PostgreSQL async in prod, SQLite async for test/dev)
DATABASE_URL=postgresql+asyncpg://ryujin:ryujin_password@localhost:5432/ryujin_db
# For local dev / testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./ryujin.db

# JWT & Security
JWT_SECRET_KEY=super-secret-key-change-me-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Layer
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
AI_DAILY_TOKEN_LIMIT=100000
AI_USER_RPM_LIMIT=10

# Server & Localization
DEFAULT_TIMEZONE=Asia/Kolkata
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
LOG_LEVEL=INFO

